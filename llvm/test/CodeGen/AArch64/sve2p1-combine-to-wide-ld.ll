; Negative: loads have !nontemporal flag
define void @ld_unpred_nt_flag(ptr %a) {
; CHECK-LABEL: ld_unpred_nt_flag:
; CHECK:         ptrue p0.s
; CHECK-NEXT:    ldnt1w { z0.s }, p0/z, [x0]
; CHECK-NEXT:    ldnt1w { z1.s }, p0/z, [x0, #1, mul vl]
; CHECK-NEXT:    ret
  %ld1 = load <vscale x 4 x i32>, ptr %a, !nontemporal !0
  %vscale = tail call i64 @llvm.vscale.i64()
  %shl = shl nuw nsw i64 %vscale, 4
  %ld_gep = getelementptr inbounds nuw i8, ptr %a, i64 %shl
  %ld2 = load <vscale x 4 x i32>, ptr %ld_gep, !nontemporal !0
  tail call void (...) @llvm.fake.use(<vscale x 4 x i32> %ld1)
  tail call void (...) @llvm.fake.use(<vscale x 4 x i32> %ld2)
  ret void
}

; Negative: do not combine extending loads
define void @ld_unpred_extend(ptr %a) {
; CHECK-LABEL: ld_unpred_extend:
; CHECK:         ptrue p0.d
; CHECK-NEXT:    ld1sw { z0.d }, p0/z, [x0]
; CHECK-NEXT:    ld1sw { z1.d }, p0/z, [x0, #1, mul vl]
; CHECK-NEXT:    ret
  %ld1 = load <vscale x 2 x i32>, ptr %a
  %ld_gep = getelementptr inbounds nuw <vscale x 2 x i32>, ptr %a, i64 1
  %ld2 = load <vscale x 2 x i32>, ptr %ld_gep
  %ext1 = sext <vscale x 2 x i32> %ld1 to <vscale x 2 x i64>
  %ext2 = sext <vscale x 2 x i32> %ld2 to <vscale x 2 x i64>
  tail call void (...) @llvm.fake.use(<vscale x 2 x i64> %ext1)
  tail call void (...) @llvm.fake.use(<vscale x 2 x i64> %ext2)
  ret void
}

!0 = !{ i32 1 }
