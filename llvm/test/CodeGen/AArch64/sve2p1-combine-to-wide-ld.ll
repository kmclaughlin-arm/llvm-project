; Test that the combine applies in the second basic block, when there is a
; load in the first block.
define void @ld_unpred_clear_chain(ptr %a, ptr %b) {
; CHECK-SVE-LABEL: ld_unpred_clear_chain:
; CHECK-SVE:         ldr w8, [x0]
; CHECK-SVE-NEXT:    cbz w8, .LBB7_2
; CHECK-SVE-NEXT:    ldr z0, [x1]
; CHECK-SVE-NEXT:    ldr z1, [x1, #1, mul vl]
; CHECK-SVE-NEXT:  .LBB7_2:
; CHECK-SVE-NEXT:    ret
;
; CHECK-SVE2p1-LABEL: ld_unpred_clear_chain:
; CHECK-SVE2p1:         ldr w8, [x0]
; CHECK-SVE2p1-NEXT:    cbz w8, .LBB7_2
; CHECK-SVE2p1-NEXT:    ptrue pn8.s
; CHECK-SVE2p1-NEXT:    ld1w { z0.s, z1.s }, pn8/z, [x1]
; CHECK-SVE2p1-NEXT:  .LBB7_2:
; CHECK-SVE2p1-NEXT:    ret
entry:
  %scalar_ld = load i32, ptr %a
  %cond = icmp ne i32 %scalar_ld, 0
  br i1 %cond, label %main, label %end

main:
  %ld0 = load <vscale x 4 x i32>, ptr %b
  %vscale = tail call i64 @llvm.vscale.i64()
  %shl1 = shl nuw nsw i64 %vscale, 4
  %gep1 = getelementptr inbounds nuw i8, ptr %b, i64 %shl1
  %ld1 = load <vscale x 4 x i32>, ptr %gep1
  tail call void (...) @llvm.fake.use(<vscale x 4 x i32> %ld0)
  tail call void (...) @llvm.fake.use(<vscale x 4 x i32> %ld1)
  br label %end

end:
  ret void
}

; Negative: store between consecutive loads
define void @ld_unpred_x2_with_store(ptr %a, ptr %b, <vscale x 4 x i32> %x) {
; CHECK-LABEL: ld_unpred_x2_with_store:
; CHECK:         ldr z1, [x0]
; CHECK-NEXT:    str z0, [x1]
; CHECK-NEXT:    ldr z0, [x0, #1, mul vl]
; CHECK-NEXT:    ret
  %ld1 = load <vscale x 4 x i32>, ptr %a
  %vscale = tail call i64 @llvm.vscale.i64()
  %shl = shl nuw nsw i64 %vscale, 4
  %ld_gep = getelementptr inbounds nuw i8, ptr %a, i64 %shl
  store <vscale x 4 x i32> %x, ptr %b
  %ld2 = load <vscale x 4 x i32>, ptr %ld_gep
  tail call void (...) @llvm.fake.use(<vscale x 4 x i32> %ld1)
  tail call void (...) @llvm.fake.use(<vscale x 4 x i32> %ld2)
  ret void
}

