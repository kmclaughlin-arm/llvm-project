; Consecutive group of six unpredicated loads, requires a x4 & x2 group
define void @ld_unpred_x6(ptr %a) {
; CHECK-SVE-LABEL: ld_unpred_x6:
; CHECK-SVE:         ldr z0, [x0]
; CHECK-SVE-NEXT:    ldr z1, [x0, #1, mul vl]
; CHECK-SVE-NEXT:    ldr z2, [x0, #2, mul vl]
; CHECK-SVE-NEXT:    ldr z3, [x0, #3, mul vl]
; CHECK-SVE-NEXT:    ldr z4, [x0, #4, mul vl]
; CHECK-SVE-NEXT:    ldr z5, [x0, #5, mul vl]
; CHECK-SVE-NEXT:    ret
;
; CHECK-SVE2p1-LABEL: ld_unpred_x6:
; CHECK-SVE2p1:         ptrue pn8.s
; CHECK-SVE2p1-NEXT:    ld1w { z0.s, z1.s }, pn8/z, [x0, #4, mul vl]
; CHECK-SVE2p1-NEXT:    ld1w { z4.s - z7.s }, pn8/z, [x0]
; CHECK-SVE2p1-NEXT:    ret
  %ld0 = load <vscale x 4 x i32>, ptr %a
  %vscale = tail call i64 @llvm.vscale.i64()
  %shl1 = shl nuw nsw i64 %vscale, 2
  %gep1 = getelementptr inbounds nuw [4 x i8], ptr %a, i64 %shl1
  %ld1 = load <vscale x 4 x i32>, ptr %gep1
  %shl2 = shl nuw nsw i64 %vscale, 3
  %gep2 = getelementptr inbounds nuw [4 x i8], ptr %a, i64 %shl2
  %ld2 = load <vscale x 4 x i32>, ptr %gep2
  %shl3 = mul nuw nsw i64 %vscale, 12
  %gep3 = getelementptr inbounds nuw [4 x i8], ptr %a, i64 %shl3
  %ld3 = load <vscale x 4 x i32>, ptr %gep3
  %shl4 = shl nuw nsw i64 %vscale, 4
  %gep4 = getelementptr inbounds nuw [4 x i8], ptr %a, i64 %shl4
  %ld4 = load <vscale x 4 x i32>, ptr %gep4
  %shl5 = mul nuw nsw i64 %vscale, 20
  %gep5 = getelementptr inbounds nuw [4 x i8], ptr %a, i64 %shl5
  %ld5 = load <vscale x 4 x i32>, ptr %gep5
  tail call void (...) @llvm.fake.use(<vscale x 4 x i32> %ld0)
  tail call void (...) @llvm.fake.use(<vscale x 4 x i32> %ld1)
  tail call void (...) @llvm.fake.use(<vscale x 4 x i32> %ld2)
  tail call void (...) @llvm.fake.use(<vscale x 4 x i32> %ld3)
  tail call void (...) @llvm.fake.use(<vscale x 4 x i32> %ld4)
  tail call void (...) @llvm.fake.use(<vscale x 4 x i32> %ld5)
  ret void
}

; Two groups of 2 consecutive loads which are part of the same chain
define void @ld_unpred_2x2(ptr %a, ptr %b) {
; CHECK-SVE-LABEL: ld_unpred_2x2:
; CHECK-SVE:         ldr z0, [x0]
; CHECK-SVE-NEXT:    ldr z1, [x0, #1, mul vl]
; CHECK-SVE-NEXT:    ldr z2, [x1]
; CHECK-SVE-NEXT:    ldr z3, [x1, #1, mul vl]
; CHECK-SVE-NEXT:    ret
;
; CHECK-SVE2p1-LABEL: ld_unpred_2x2:
; CHECK-SVE2p1:         ptrue pn8.s
; CHECK-SVE2p1-NEXT:    ld1w { z0.s, z1.s }, pn8/z, [x1]
; CHECK-SVE2p1-NEXT:    ld1w { z2.s, z3.s }, pn8/z, [x0]
; CHECK-SVE2p1-NEXT:    ret
  %ld0 = load <vscale x 4 x i32>, ptr %a
  %vscale = tail call i64 @llvm.vscale.i64()
  %shl1 = shl nuw nsw i64 %vscale, 2
  %gep1 = getelementptr inbounds nuw [4 x i8], ptr %a, i64 %shl1
  %ld1 = load <vscale x 4 x i32>, ptr %gep1
  %ld2 = load <vscale x 4 x i32>, ptr %b
  %gep3 = getelementptr inbounds nuw [4 x i8], ptr %b, i64 %shl1
  %ld3 = load <vscale x 4 x i32>, ptr %gep3
  tail call void (...) @llvm.fake.use(<vscale x 4 x i32> %ld0)
  tail call void (...) @llvm.fake.use(<vscale x 4 x i32> %ld1)
  tail call void (...) @llvm.fake.use(<vscale x 4 x i32> %ld2)
  tail call void (...) @llvm.fake.use(<vscale x 4 x i32> %ld3)
  ret void
}

; Store between first and second loads, but still safe to replace with multi-vector load
define void @ld_unpred_x2_store(ptr %a) {
; CHECK-SVE-LABEL: ld_unpred_x2_store:
; CHECK-SVE:         ldr z0, [x0]
; CHECK-SVE-NEXT:    ldr z2, [x0, #1, mul vl]
; CHECK-SVE-NEXT:    add z1.s, z0.s, z0.s
; CHECK-SVE-NEXT:    str z1, [x0]
; CHECK-SVE-NEXT:    ret
;
; CHECK-SVE2p1-LABEL: ld_unpred_x2_store:
; CHECK-SVE2p1:         ptrue pn8.s
; CHECK-SVE2p1-NEXT:    ld1w { z0.s, z1.s }, pn8/z, [x0]
; CHECK-SVE2p1-NEXT:    add z2.s, z0.s, z0.s
; CHECK-SVE2p1-NEXT:    str z2, [x0]
; CHECK-SVE2p1-NEXT:    ret
  %ld1 = load <vscale x 4 x i32>, ptr %a
  %add1 = add <vscale x 4 x i32> %ld1, %ld1
  store <vscale x 4 x i32> %add1, ptr %a
  %vscale = tail call i64 @llvm.vscale.i64()
  %shl = shl nuw nsw i64 %vscale, 4
  %ld_gep = getelementptr inbounds nuw i8, ptr %a, i64 %shl
  %ld2 = load <vscale x 4 x i32>, ptr %ld_gep
  tail call void (...) @llvm.fake.use(<vscale x 4 x i32> %ld1)
  tail call void (...) @llvm.fake.use(<vscale x 4 x i32> %ld2)
  ret void
}

; Test combine when the type will be promoted
define void @ld_unpred_narrow(ptr %a) {
; CHECK-SVE-LABEL: ld_unpred_narrow:
; CHECK-SVE:         ptrue p0.d
; CHECK-SVE-NEXT:    ld1w { z0.d }, p0/z, [x0]
; CHECK-SVE-NEXT:    ld1w { z1.d }, p0/z, [x0, #1, mul vl]
; CHECK-SVE-NEXT:    ret
;
; CHECK-SVE2p1-LABEL: ld_unpred_narrow:
; CHECK-SVE2p1:         ldr z0, [x0]
; CHECK-SVE2p1-NEXT:    uunpklo z1.d, z0.s
; CHECK-SVE2p1-NEXT:    uunpkhi z0.d, z0.s
; CHECK-SVE2p1-NEXT:    ret
  %ld1 = load <vscale x 2 x i32>, ptr %a
  %vscale = tail call i64 @llvm.vscale.i64()
  %shl = shl nuw nsw i64 %vscale, 3
  %ld_gep = getelementptr inbounds nuw i8, ptr %a, i64 %shl
  %ld2 = load <vscale x 2 x i32>, ptr %ld_gep
  tail call void (...) @llvm.fake.use(<vscale x 2 x i32> %ld1)
  tail call void (...) @llvm.fake.use(<vscale x 2 x i32> %ld2)
  ret void
}

