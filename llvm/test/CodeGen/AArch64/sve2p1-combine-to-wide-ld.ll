; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mattr=+sve -aarch64-enable-subreg-liveness-tracking -asm-verbose=false -verify-machineinstrs < %s | FileCheck %s -check-prefixes=CHECK,CHECK-SVE
; RUN: llc -mattr=+sve2p1 -aarch64-enable-subreg-liveness-tracking -asm-verbose=false -verify-machineinstrs < %s | FileCheck %s -check-prefixes=CHECK,CHECK-SVE2p1

target triple = "aarch64-unknown-linux-gnu"

define void @ld_unpred_x2(ptr %a) {
; CHECK-SVE-LABEL: ld_unpred_x2:
; CHECK-SVE:         ldr z0, [x0]
; CHECK-SVE-NEXT:    ldr z1, [x0, #1, mul vl]
; CHECK-SVE-NEXT:    ret
;
; CHECK-SVE2p1-LABEL: ld_unpred_x2:
; CHECK-SVE2p1:         ptrue pn8.s
; CHECK-SVE2p1-NEXT:    ld1w { z0.s, z1.s }, pn8/z, [x0]
; CHECK-SVE2p1-NEXT:    ret
  %ld1 = load <vscale x 4 x i32>, ptr %a
  %vscale = tail call i64 @llvm.vscale.i64()
  %shl = shl nuw nsw i64 %vscale, 4
  %ld_gep = getelementptr inbounds nuw i8, ptr %a, i64 %shl
  %ld2 = load <vscale x 4 x i32>, ptr %ld_gep
  tail call void (...) @llvm.fake.use(<vscale x 4 x i32> %ld1)
  tail call void (...) @llvm.fake.use(<vscale x 4 x i32> %ld2)
  ret void
}

